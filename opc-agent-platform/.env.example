LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
A2A_REQUEST_TIMEOUT=120
OPC_PUBLIC_BASE_URL=http://127.0.0.1:8010
# Optional: expose a second computer as the default public A2A target.
OPC_REMOTE_AGENT_B_URL=https://your-domain.example/agent-b/a2a/shen-zhiye

# Outbound Relay connection. Use the same token on the Relay server and both nodes.
OPC_RELAY_URL=wss://your-domain.example/api/relay/ws
OPC_RELAY_TOKEN=replace-with-a-long-random-token
OPC_NODE_AGENT_ID=opc-builder
OPC_LOCAL_AGENT_URL=http://127.0.0.1:8010/a2a/opc-builder

# Set LLM_PROVIDER=deepseek to use these cloud settings instead.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=medium
